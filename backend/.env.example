# Claude (no key = offline mode, deterministic fractions demo)
ANTHROPIC_API_KEY=
# PIP_CHAT_MODEL=
# PIP_WORK_MODEL=

# MongoDB (unset = in-memory store). Emergent provides these.
MONGO_URL=
DB_NAME=pip

# Where the frontend lives (Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Twilio test-mode parent update (all four, else "test-mode (not delivered)")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TEST_PARENT_PHONE=

# Stripe test key only (must start with sk_test_); unset = simulated checkout
STRIPE_SECRET_KEY=
