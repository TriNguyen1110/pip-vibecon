# Claude (no key = offline mode, deterministic fractions demo)
ANTHROPIC_API_KEY=
# PIP_CHAT_MODEL=
# PIP_WORK_MODEL=

# MongoDB (unset = in-memory store). Emergent provides these.
MONGO_URL=
DB_NAME=pip

# Where the frontend lives (Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Twilio test-mode parent update (all four, else "test-mode (not delivered)")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TEST_PARENT_PHONE=

# Stripe test key only (must start with sk_test_); unset = simulated checkout
STRIPE_SECRET_KEY=

# ElevenLabs voice for Pip (all of key + voice id needed, else the browser voice is used).
# Pick a voice id in the ElevenLabs dashboard (Voices > a voice > "ID") or GET https://api.elevenlabs.io/v1/voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Default is eleven_multilingual_v2 (documented default of /with-timestamps). eleven_flash_v2_5 is lower latency;
# if the endpoint rejects the model (400/422) the backend retries once with the default.
ELEVENLABS_MODEL=eleven_v4_turbo   # or eleven_v4; both verified with /with-timestamps on 2026-10-24
